# if it is local database, you can use the following connection string:
# MONGODB_URI=mongodb://localhost:27017

# this is for atlas cluster, you can use the following connection string:
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_NAME=your_database_name



# use different secret key for production
# For creating a new signing key, you can use the following command in your terminal:
# python -c "python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"" 
# key will be created like this: xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Add the generated key to: django-insecure-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DJANGO_SECRET_KEY=your_secret_key

DEBUG=True
ALLOWED_HOSTS=your_allowed_hosts1, your_allowed_hosts2

CORS_ALLOWED_ORIGINS=your_frontend_url_1,your_frontend_url_2

# for creating a new signing key, you can use the following command in your terminal:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
SIMPLE_JWT_SIGNING_KEY=your_jwt_signing_key



# Cloudflare R2 Configuration
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET_NAME=lms-media
